{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "trailingSlash": true,
  "routes": [
    {
      "src": "^/company-(?:outing|trip)/?$",
      "headers": {
        "Location": "/corporate-packages/indonesia-region/"
      },
      "status": 308
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": { "eq": "staging.conscioustravel.id" }
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.conscioustravel.id" }],
      "destination": "https://conscioustravel.id/:path*",
      "permanent": true
    },
    {
      "source": "/bali/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/private-trip/",
      "destination": "/experiences/",
      "permanent": true
    },
    {
      "source": "/open-trip/",
      "destination": "/experiences/",
      "permanent": true
    },
    {
      "source": "/open-trip-europe/",
      "destination": "/experiences/",
      "permanent": true
    }
  ]
}
