{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/company-outing/:path*",
      "destination": "/corporate-packages/indonesia-region/",
      "permanent": true
    },
    {
      "source": "/company-trip/:path*",
      "destination": "/corporate-packages/indonesia-region/",
      "permanent": true
    },
    {
      "source": "/bali/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/private-trip/",
      "destination": "/experiences/",
      "permanent": true
    },
    {
      "source": "/open-trip/",
      "destination": "/experiences/",
      "permanent": true
    },
    {
      "source": "/open-trip-europe/",
      "destination": "/experiences/",
      "permanent": true
    }
  ]
}
